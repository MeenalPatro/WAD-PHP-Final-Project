# .htaccess
RewriteEngine On

# Prevent directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "^(config\.php|database\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Custom error pages
ErrorDocument 404 /asmeera-lifeline/404.php
ErrorDocument 403 /asmeera-lifeline/403.php

# PHP settings
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300